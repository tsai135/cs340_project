<!DOCTYPE html>
<html>
<head>
    <title>Manage Statuses</title>
    <link rel="stylesheet" type="text/css" href="style.css">
    <script language="JavaScript">
        function showform(dowhat) {
            document.getElementById('add').style.display = 'none';
            document.getElementById('update').style.display = 'none';
            document.getElementById('delete').style.display = 'none';

            switch(dowhat) {
                case 'add':
                    document.getElementById('add').style.display = 'block';
                    break;
                case 'update':
                    document.getElementById('update').style.display = 'block';
                    break;
                case 'delete':
                    document.getElementById('delete').style.display = 'block';
                    break;
                default:
                    document.getElementById('add').style.display = 'block';
            }
        }

        function addStatus() { showform('add'); }
        function updateStatus(statusID) {
    // Fetch the existing status data and display it in the update form
    fetch('/get-status/' + statusID)
        .then(response => response.json())
        .then(data => {
            document.getElementById('input-statusID-update').value = data.statusID;
            document.getElementById('input-statusName-update').value = data.statusName;
            document.getElementById('input-statusDescription-update').value = data.statusDescription;
            document.getElementById('input-statusDate-update').value = data.statusDate;

            // Show the update form
            showform('update');
        })
        .catch(error => console.error('Error:', error));

    // Handle form submission for update
document.getElementById('update-status-form').onsubmit = function(event) {
    event.preventDefault(); // Prevent the form from submitting in the default way

    let statusID = document.getElementById('input-statusID-update').value; // Make sure you have this line to get the status ID
    let updatedStatus = {
        statusName: document.getElementById('input-statusName-update').value,
        statusDescription: document.getElementById('input-statusDescription-update').value,
        statusDate: document.getElementById('input-statusDate-update').value
    };

    fetch('/update-status-ajax/' + statusID, {
        method: 'PUT',
        headers: {
            'Content-Type': 'application/json',
        },
        body: JSON.stringify(updatedStatus)
    })
    .then(response => {
        if (!response.ok) {
            throw new Error('Network response was not ok');
        }
        location.reload(); // Reload the page to see updated data
    })
    .catch((error) => {
        console.error('Error:', error);
        alert('Error updating status');
    });
};

}


function deleteStatus(statusID) {
    const confirmation = confirm("Are you sure you want to delete this status?");
    if (confirmation) {
        fetch('/delete-status-ajax/' + statusID, { method: 'DELETE' })
            .then(response => {
                if (response.ok) {
                    // Auto-refresh the page to update the list
                    location.reload();
                } else {
                    // Handle the error if the response is not okay
                    console.error('Error in deleting status');
                }
            })
            .catch(error => console.error('Error:', error));
    }
}

    </script>
</head>
<body onload="addStatus()">
    <h1>Manage Statuses</h1>
    <nav>
        <a href="index.hbs">Home</a>
        <a href="view-equipment-transactions.hbs">Equipment Lookup</a>
        <a href="manage-equipment-transactions.hbs">Equipment Transactions</a>
        <a href="shop-inventory.hbs">Shop Inventory</a>
    </nav>
    <nav>
        <h2>Advanced Tools</h2>
        <a href="manage-equipments.hbs">Equipment Management</a>
        <a href="manage-equipment-types.hbs">Equipment Types</a>
        <a href="manage-properties.hbs">Item Properties</a>
        <a href="manage-equipment-properties.hbs">Equipment Details</a>
        <a href="manage-equipment-type-properties.hbs">Type-Specific Properties</a>
        <a href="manage-statuses.hbs">Status Management</a>
        <a href="manage-transition-statuses.hbs">Workflow Management</a>
    </nav>
    <br>
<main>
<section>
    <!-- Section for Adding New Status -->
    <div id="add">
        <h2>Add New Status</h2>
        <form id="add-status-form">
            <label for="input-statusName">Status Name:</label>
            <input type="text" id="input-statusName" name="statusName" required>

            <label for="input-statusDescription">Status Description:</label>
            <input type="text" id="input-statusDescription" name="statusDescription">

            <label for="input-statusDate">Status Date:</label>
            <input type="date" id="input-statusDate" name="statusDate">

            <input type="submit" value="Add Status">
        </form>
    </div>

    <!-- Section for Updating Status -->
    <div id="update" style="display: none">
        <h2>Update Status</h2>
        <form id="update-status-form">
            <input type="hidden" id="input-statusID-update" name="statusID">

            <label for="input-statusName-update">Status Name:</label>
            <input type="text" id="input-statusName-update" name="statusName" required>

            <label for="input-statusDescription-update">Status Description:</label>
            <input type="text" id="input-statusDescription-update" name="statusDescription">

            <label for="input-statusDate-update">Status Date:</label>
            <input type="date" id="input-statusDate-update" name="statusDate">

            <input type="submit" value="Update Status">
            <button type="button" onclick="addStatus()">Cancel</button>
        </form>
    </div>

    <!-- Section for Deleting Status -->
    <div id="delete" style="display: none">
        <h2>Delete Status</h2>
        <form id="delete-status-form">
            <p>Are you sure you want to delete this status?</p>
            <input type="hidden" id="input-statusID-delete" name="statusID">
            <input type="submit" value="Delete Status">
            <button type="button" onclick="addStatus()">Cancel</button>
        </form>
    </div>

    <!-- Section for Viewing Statuses -->
    <div id="view">
        <h2>View Statuses</h2>
        <table>
            <thead>
                <tr>
                    <th>Status ID</th>
                    <th>Status Name</th>
                    <th>Description</th>
                    <th>Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {{#each statuses}}
                <tr>
                    <td>{{this.statusID}}</td>
                    <td>{{this.statusName}}</td>
                    <td>{{this.statusDescription}}</td>
                    <td>{{this.statusDate}}</td>
                    <td>
                        <button onclick="updateStatus({{this.statusID}})">Edit</button>
                        <button onclick="deleteStatus({{this.statusID}})">Delete</button>
                    </td>
                </tr>
                {{/each}}
            </tbody>
        </table>
    </div>
</section>
</main>

    <!-- Scripts for AJAX requests and form handling -->
    <script src="./js/add_status.js"></script>
    <script src="./js/update_status.js"></script>
    <script src="./js/delete_status.js"></script>
</body>

</html>
