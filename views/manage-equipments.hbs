    <br>
<div id="browse">
    <main>
        <section>


            <h1>Add New Equipment</h1>

            <!-- Form to add a record to the table  -->

            <p>To add a new equipment, please enter its information below and click 'Submit'!</p>
            <form id="add-equipment-form-ajax">
                <label for="input-barcode">Barcode: </label>
                <input type="text" name="input-barcode" id="input-barcode">
                
                <label for="input-serializationTimestamp">Time: </label>
                <input type="datetime-local" name="input-serializationTimestamp" id="input-serializationTimestamp">

                <label for="input-equipmentType">Type: </label>
                    <select name="input-equipmentType" id="input-equipmentType">
                        <option value="">Select an Equipment Type</option>
                        {{#each equipmentTypes}}
                        <option value="{{this.equipmentTypeID}}">{{this.equipmentTypeName}}</option>
                        {{/each}}
                    </select>

                <br>
                <br>

                <!-- Dynamic form fields based on equipment type -->
                <div id="dynamic-fields-container"></div>

                <br>
                <br>

                <input type="submit">
            </form>

            <script>
                // Attach an event listener to the equipmentType dropdown
                $('#input-equipmentType').change(function() {
                    var selectedEquipmentType = $(this).val();

                    // Make an AJAX request to fetch properties based on the selected equipment type
                    $.ajax({
                        url: '/get-properties', // Create a new route in the server to handle this request
                        method: 'GET',
                        data: { equipmentTypeID: selectedEquipmentType },
                        success: function(data) {
                            // Update the dynamic form fields based on the response
                            var dynamicFieldsContainer = $('#dynamic-fields-container');
                            dynamicFieldsContainer.empty();

                            $.each(data, function(index, property) {
                                dynamicFieldsContainer.append(`
                                    <label for="input-${property.propertyID}">${property.Property}: </label>
                                    <input type="text" name="input-${property.propertyID}" id="input-${property.Property}">
                                    <br>
                                    <br>
                                `);
                            });
                        },
                        error: function(error) {
                            console.error('Error fetching properties:', error);
                        }
                    });
                });
            </script>

            <br>
            <br>
            <br>
            <br>

            <h1>Manage Existing Equipment</h1>

            <br>


            {{!-- Create a table --}}
            <table id="equipments-table">
                {{!-- Header section --}}
                <thead>
                    {{!-- For just the first row, we print each key of the row object as a header cell so we know what each column means when the page renders --}}
                    <tr>
                        <th>Equipment ID</th>
                        <th>Equipment Barcode</th>
                        <th>Serialized Datetime</th>
                        <th>Type</th>
                        <th>Action</th>
                    </tr>
                </thead>

                {{!-- Body section --}}
                <tbody>
                    {{!-- For each row, print the id, barcode, serialized datetime, and equipment type ID, in order --}}
                    {{#each data}}
                    <tr>
                        <td>{{this.equipmentID}}</td>
                        <td>{{this.barcode}}</td>
                        <td>{{this.serializationTimestamp}}</td>
                        <td>{{this.equipmentTypeName}}</td>
                        <td>
                            <button class="btn edit" onClick="handleEditClick('{{this.equipmentID}}')">Edit</button>
                            <button class="btn delete" onClick="deleteEquipment('{{this.equipmentID}}', '{{this.barcode}}')">Delete</button>
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
            <script src="./js/delete_equipment.js"></script>
            
            <br>
            <br>
            <br>
            <br>

        </section>
    </main>
