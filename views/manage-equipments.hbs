    <form method="POST" id="deleteEquipment">
        <legend><strong>Delete Equipment</strong></legend>
            <fieldset class="fields">
            <p>Are you sure you wish to delete the following?</p>
            {{!-- <input type="hidden" name="equipmentID" id="deleteequipmentID" value="1"> --}}
            <label> <strong>ID: </strong></label> <span id="deleteequipmentID"></span>
              <label> <strong>Barcode: </strong> </label> <span id="deleteBarcode"></span>
              
      </fieldset>
      <input class="btn" type="submit" id="DeleteEquipment" value="Delete Equipment">
