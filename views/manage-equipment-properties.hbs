<!DOCTYPE html>
<html>
<head>
    <title>Manage Equipment Details</title>
    <link rel="stylesheet" type="text/css" href="style.css">
    <script language="JavaScript">
        function showform(dowhat) {
            document.getElementById('add').style.display = 'none';
            document.getElementById('update').style.display = 'none';
            document.getElementById('delete').style.display = 'none';

            switch(dowhat) {
                case 'add':
                    document.getElementById('add').style.display = 'block';
                    break;
                case 'update':
                    document.getElementById('update').style.display = 'block';
                    break;
                case 'delete':
                    document.getElementById('delete').style.display = 'block';
                    break;
                default:
                    document.getElementById('add').style.display = 'block';
            }
        }

        function addEquipmentDetail() { showform('add'); }
        function updateEquipmentDetail(equipmentID, propertyID) {
    // Fetch the existing equipment details data and display it in the update form
    fetch('/get-equipment-details/' + equipmentID)
        .then(response => response.json())
        .then(data => {
            document.getElementById('input-propertyID-update').value = data.equipmentID;
            document.getElementById('input-value-update').value = data.equipmentPropertyValue;

            // Show the update form
            showform('update');
        })
        .catch(error => console.error('Error:', error));

    // Handle form submission for update
    document.getElementById('update-equipment-details-form').onsubmit = function(event) {
        event.preventDefault(); // Prevent the form from submitting in the default way

        let updatedEquipmentDetails = {
            equipmentPropertyValue: document.getElementById('input-value-update').value
        };

        fetch('/update-equipment-details-ajax/' + equipmentID + propertyID, {
            method: 'PUT',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify(updatedEquipmentDetails)
        })
        .then(response => {
            if (!response.ok) {
                throw new Error('Network response was not ok');
            }
            return response.text();
        })
        .then(() => {
            alert('Equipment detail updated successfully');
            location.reload(); // Optionally, refresh the status list
        })
        .catch((error) => {
            console.error('Error:', error);
            alert('Error updating equipment detail');
        });
    };
}


    function nullifyEquipmentDetail(equipmentID, propertyID) {
        const confirmation = confirm("Are you sure you want to make this property empty? Properties are linked to equipment type and thus cannot be deleted.");
        if (confirmation) {
            fetch('/nullify-equipment-detail-ajax/' + equipmentID + propertyID, { method: 'UPDATE' })
                .then(() => {
                    // Code to refresh or update the equipment details view
                    // alert("Status deleted successfully");
                    location.reload(); // Refresh the page to update the list
                })
                .catch(error => console.error('Error:', error));
        }
    }
    </script>
</head>
