<!-- manage-properties.hbs -->
<!DOCTYPE html>
<html>
<script language="JavaScript">
    /**
     * Toggles visibility of different sections in the equipment management interface.
     * 
     * @param {string} dowhat - The action to be performed ('insert', 'update', 'delete', 'all', or default view).
     * This function controls the display of four main sections: browse, insert, update, and delete.
     * Based on the action, it hides or shows relevant sections to the user.
     */
    function showform(dowhat) {
        // Hide all sections initially
        document.getElementById('browse').style.display = 'none';
        //document.getElementById('insert').style.display = 'none';
        document.getElementById('update').style.display = 'none';
        document.getElementById('delete').style.display = 'none';

        // Based on the 'dowhat' parameter, make a specific section visible
        switch(dowhat) {
            case 'insert':
                //document.getElementById('insert').style.display = 'block';
                break;
            case 'update':
                document.getElementById('update').style.display = 'block';
                break;
            case 'delete':
                document.getElementById('delete').style.display = 'block';
                break;
            case 'all':
                document.getElementById('browse').style.display = 'block';
                //document.getElementById('insert').style.display = 'block';
                document.getElementById('update').style.display = 'block';
                document.getElementById('delete').style.display = 'block';
                break;
            default:
                // Default view is 'browse'
                document.getElementById('browse').style.display = 'block';
        }
    }

    // Helper functions to invoke 'showform' with specific actions
    function newProperty() { showform('insert'); }
    function updateProperty(pid) { showform('update'); }
    function browseProperties() { showform ('browse'); }
    function showAll() { showform ('all'); }
</script>

<head>
    <title>Manage Item Properties</title>
    <link rel="stylesheet" type="text/css" href="style.css">
    <style>

    </style>
</head>
