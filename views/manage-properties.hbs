<div id="browse">
    <main>
        <section>


            <h1>Add New Item Property</h1>

            <!-- Form to add a record to the table  -->

            <p>To add a new item property, please enter its information below and click 'Submit'!</p>
            <form id="add-property-form-ajax">
                <label for="input-propertyName">Name of Item Property: </label>
                <input type="text" name="input-propertyName" id="input-propertyName">

                <br>
                <br>

                <input type="submit">
            </form>

            <br>
            <br>
            <br>
            <br>



            <h1>Manage Existing Item Properties</h1>

            <br>


            {{!-- Create a table --}}
            <table id="properties-table">
                {{!-- Header section --}}
                <thead>
                    {{!-- For just the first row, we print each key of the row object as a header cell so we know what each column means when the page renders --}}
                    <tr>
                        <th>Property ID</th>
                        <th>Property Name</th>
                        <th>
                            Action
                        </th>
                    </tr>
                </thead>

                {{!-- Body section --}}
                <tbody>
                    {{!-- For each row, print each attribute in order --}}
                    {{#each data}}
                    <tr>
                        <td>{{this.propertyID}}</td>
                        <td>{{this.propertyName}}</td>
                        {{!-- <td>{{this.propertyDescription}}</td> --}}
                        <td>
                            <button class="btn edit" onClick="handleEditClick('{{this.propertyID}}')">Edit</button>
                            <button class="btn delete" onClick="deleteProperty('{{this.propertyID}}', '{{this.propertyName}}')">Delete</button>
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
            <script src="./js/delete_property.js"></script>
            
            <br>
            <br>
            <br>
            <br>

        </section>
    </main>
