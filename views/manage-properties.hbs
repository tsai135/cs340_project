            <label> <strong>ID: </strong></label> <span id="deletePropertyID"></span>
              <label> <strong>Equipment Type Name: </strong> </label> <span id="deletePropertyName"></span>
              
      </fieldset>
      <input class="btn" type="submit" id="DeleteProperty" value="Delete Item Property">
